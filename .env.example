MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0
JWT_SECRET=your_jwt_secret_here
NODE_ENV=production

# Persistent storage folder OUTSIDE deployment folder (fallback if Cloudinary not set)
UPLOAD_DIR=../modelconnect_storage

# Cloudinary Cloud Storage (Recommended for Render, AWS, Vercel)
# Obtain these free from https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# OR simply paste your full Cloudinary URL:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Resend Email Configuration (https://resend.com)
# Obtain free from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# If your domain is verified on Resend, e.g. "ModelConnect <noreply@yourdomain.com>"
# Razorpay Payment Gateway (https://dashboard.razorpay.com/app/keys)
# Use test keys in development: rzp_test_...
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET


